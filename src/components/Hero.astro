---
---

<section class="hero" id="inicio">
  <!-- 
    IMAGEN DE FONDO: Reemplaza la URL de abajo con la ruta a tu imagen de alta calidad.
    Ejemplo: background-image: url('/images/hero-bg.jpg')
    Resolución recomendada: 1920x1080px o superior.
  -->
  <div class="hero-bg" style="background-image: url('/src/images/vista general interior galpon.jpg')"></div>
  <div class="hero-overlay"></div>

  <div class="hero-content">
    <div class="hero-eyebrow reveal">
      <span class="gold-line"></span>
      <span>Desde 2016 · Santiago, Chile</span>
    </div>

    <h1 class="hero-title reveal">
      Construimos<br />
      <em>con precisión,</em><br />
      <span class="title-accent">permanecemos</span><br />
      en el tiempo.
    </h1>

    <p class="hero-sub reveal">
      Especialistas en trabajos para el hogar, portones, rejas y protecciones.<br class="hide-sm" />
      Soluciones a medida con acabados de alta calidad.
    </p>

    <div class="hero-actions reveal">
      <a href="#proyectos" class="btn-primary">Ver Proyectos</a>
      <a href="#nosotros" class="btn-ghost">Conocer la empresa</a>
    </div>
  </div>

  <!-- Indicador de scroll -->
  <div class="scroll-hint">
    <div class="scroll-line"></div>
    <span>Scroll</span>
  </div>

  <!-- Métricas flotantes -->
  <div class="hero-stats reveal">
    <div class="stat">
      <span class="stat-num">+100</span>
      <span class="stat-label">Proyectos</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat">
      <span class="stat-num">10+</span>
      <span class="stat-label">Años de experiencia</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat">
      <span class="stat-num">99%</span>
      <span class="stat-label">Clientes satisfechos</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 620px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transform: scale(1.05);
    transition: transform 8s ease;
    will-change: transform;
  }

  .hero:hover .hero-bg { transform: scale(1.0); }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(13, 15, 17, 0.88) 0%,
      rgba(13, 15, 17, 0.60) 50%,
      rgba(13, 15, 17, 0.40) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    padding: 0 2rem;
    padding-top: 72px;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
    transition-delay: 0.1s;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    font-weight: 300;
    line-height: 1.05;
    color: var(--color-text);
    margin-bottom: 1.5rem;
    transition-delay: 0.2s;
  }

  .hero-title em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-accent);
  }

  .title-accent {
    -webkit-text-stroke: 1px var(--color-text);
    color: transparent;
  }

  .hero-sub {
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    color: var(--color-muted);
    line-height: 1.8;
    margin-bottom: 2.5rem;
    max-width: 480px;
    transition-delay: 0.3s;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    transition-delay: 0.4s;
  }

  .btn-primary {
    display: inline-block;
    padding: 14px 32px;
    background: var(--color-accent);
    color: #0d0f11;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background 0.25s, transform 0.2s;
  }

  .btn-primary:hover {
    background: #d4b47a;
    transform: translateY(-1px);
  }

  .btn-ghost {
    display: inline-block;
    padding: 14px 32px;
    border: 1px solid rgba(232, 228, 221, 0.25);
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: border-color 0.25s, background 0.25s;
  }

  .btn-ghost:hover {
    border-color: var(--color-text);
    background: rgba(232,228,221,0.05);
  }

  /* Scroll indicator */
  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    z-index: 2;
    animation: scrollPulse 2.5s ease infinite;
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--color-accent), transparent);
  }

  .scroll-hint span {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    writing-mode: vertical-rl;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.5; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(6px); }
  }

  /* Stats bar */
  .hero-stats {
    position: absolute;
    bottom: 0;
    right: 0;
    background: rgba(21, 23, 25, 0.85);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    padding: 1.25rem 2rem;
    gap: 2rem;
    z-index: 2;
    transition-delay: 0.5s;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 300;
    color: var(--color-accent);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border);
  }

  .hide-sm { display: inline; }

  @media (max-width: 640px) {
    .hero-stats { display: none; }
    .scroll-hint { display: none; }
    .hide-sm { display: none; }
    .hero-content { padding: 0 1.25rem; padding-top: 72px; }
  }
</style>
